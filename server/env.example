# ═══════════════════════════════════════════════════════════════
#  .env.example — шаблон переменных окружения ChessHome
# ═══════════════════════════════════════════════════════════════
# Скопируй этот файл в .env и подставь свои значения:
#   cp .env.example .env
#
# .env НЕ должен попадать в git — проверь, что в .gitignore есть
# строка ".env" (сам .env.example коммитить можно и нужно).
# ═══════════════════════════════════════════════════════════════


# ── ОБЯЗАТЕЛЬНО ─────────────────────────────────────────────────

# Строка подключения к PostgreSQL. Без неё сервер не стартует.
# Локально (после того как поднял постгрес и накатил миграции):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chesshome

# Секрет для подписи JWT-токенов авторизации. Без него сервер
# запустится, но логин/регистрация не будут работать (jwt упадёт
# при попытке подписать токен). Впиши любую длинную случайную
# строку — например, сгенерируй так:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string


# Старт сезона квестов (ISO-дата). По умолчанию — 1 сентября 2026 UTC.
SEASON_START=2026-09-01T00:00:00Z

# ── ОПЦИОНАЛЬНО (сервер стартует и без этого) ───────────────────

# Порт, на котором слушает сервер. По умолчанию 10000.
PORT=3000

# development — куки без Secure-флага (нужно для http://localhost).
# production  — куки с Secure (нужен HTTPS).
NODE_ENV=development

# Публичный адрес сайта: whitelist CORS/Socket.IO origin.
# По умолчанию используется https://chesshome.pro, если не задать.
SITE_URL=http://localhost:3000

# Токен Lichess API — используется в интеграции с Lichess.
# Без него соответствующая фича просто не будет работать.
LICHESS_API_TOKEN=

# Секретный ключ для скрипта импорта турниров Durka
# (см. durkaKeyMiddleware в core.js) — без него соответствующий
# админ-эндпоинт просто откажет с 500, остальное не затронуто.
DURKA_ADMIN_KEY=

# Секрет для авторизации воркера анализа партий (см. sockets.js).
# Без него функция анализа не будет работать, сервер не упадёт.
WORKER_SECRET=

# URL Go-сервиса подсчёта нового рейтинга. Если не задан или
# недоступен — сервер сам падает обратно на JS-формулу расчёта
# рейтинга (см. calcNewRatings в core.js), так что для локального
# теста можно вообще не трогать.
RATING_SERVICE_URL=http://127.0.0.1:8081/api/rating/calculate
